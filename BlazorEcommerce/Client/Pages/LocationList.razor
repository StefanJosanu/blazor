@page "/locations"
@using BlazorEcommerce.Shared
@using System.Net.Http.Json
@inject HttpClient httpClient
@inject ILocationService locationService
@inject NavigationManager navigation
@inject IDialogService DialogService

@if (locations != null)
{
    <div class="table_container">
        <div class="container">
            <h1>Location List</h1>
            <MudTable Items="@locations" Hover="true" Breakpoint="Breakpoint.Sm" LoadingProgressColor="Color.Info">
                <ToolBarContent>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@OpenCreateDialogAsync">Add Location</MudButton>
                </ToolBarContent>
                <HeaderContent>
                    <MudTh>Name</MudTh>
                    <MudTh>Address</MudTh>
                    <MudTh></MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Name">@context.Name</MudTd>
                    <MudTd DataLabel="Address">@context.Address</MudTd>
                    <MudTd style="width: 10vw;">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="() => OpenEditDialogAsync(context)">
                            <MudIcon Icon="@Icons.Material.Filled.Edit" Title="Edit" />
                        </MudButton>
                        <MudButton Variant="Variant.Filled" Color="Color.Error" OnClick="() => OpenDeleteDialog(context.Id, context.Name)">
                            <MudIcon Icon="@Icons.Material.Filled.Delete" Color="Color.Inherit" Title="Delete" />
                        </MudButton>
                    </MudTd>
                </RowTemplate>
            </MudTable>
        </div>
    </div>
}

@if (locations == null)
{
    <div class="container">
         <span>Location List is empty.</span>
    </div>
}

@if (locations != null && locations.Count == 0)
{
    <div class="container">
        <span>Location List is empty.</span>
    </div>
}

@code {
    private List<LocationManagementDTO> locations { get; set; }

    protected override async Task OnInitializedAsync()
    {
        locations = await locationService.GetLocations();
    }
    private Task OpenCreateDialogAsync()
    {
        var options = new DialogOptions { CloseOnEscapeKey = true };

        return DialogService.ShowAsync<Components.CreateLocationDialog>("Create Location", options);
    }

    private Task OpenEditDialogAsync(LocationManagementDTO location)
    {
        var options = new DialogOptions { CloseOnEscapeKey = true };
        var parameters = new DialogParameters<Components.EditLocationDialog>
            {
                {x=>x.EditLocation, new LocationManagementDTO
                {
                    Id = location.Id,
                    Name = location.Name,
                    Address = location.Address
                }
                }
            };
        return DialogService.ShowAsync<Components.EditLocationDialog>("Edit Location", parameters, options);
    }
    private Task OpenDeleteDialog(Guid? id, string name)
    {
        var options = new DialogOptions { CloseOnEscapeKey = true };
        var parameters = new DialogParameters<Components.DeleteLocationDialog>
        {
            {x => x.SelectedId, id},
            {x=> x.SelectedName, name}
        };
        return DialogService.ShowAsync<Components.DeleteLocationDialog>("", parameters, options);
    }
}